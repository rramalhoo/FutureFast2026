# ---------------------------------------------------------------------------
# Genvity — variáveis de ambiente
# Copie para .env.local e preencha. Nunca commite valores reais.
# ---------------------------------------------------------------------------

# URL pública da aplicação (usada em e-mails, QR Codes e redirecionamentos)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Settings → API). A chave anon/publishable é pública por design;
# a proteção dos dados é feita por Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOMENTE SERVIDOR. Usada para finalizar emissões assinadas e para funções
# administrativas do Auth. Nunca exponha com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Provedor de assinatura digital de prescrições:
#   none            → emissão bloqueada até integrar um provedor ICP-Brasil
#   dev-unsigned    → SOMENTE desenvolvimento: sela com HMAC, SEM validade jurídica
SIGNATURE_PROVIDER=none
# Segredo do selo HMAC de desenvolvimento (mín. 32 caracteres)
SIGNATURE_DEV_SECRET=

# Assistente de produtividade do médico (opcional). Sem chave, os recursos
# de IA ficam desabilitados e sinalizados na interface.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
